{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Liste von Studenten",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "email"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "integer", "minimum": 1 },
      "name": { "type": "string" },
      "email": { "type": "string" }
    }
  }
}
